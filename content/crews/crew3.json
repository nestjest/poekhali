        "статус"
      ],
      "uses": [
        "число очагов и площадь — от Оператора"
      ],
      "template": [
        "if ___ == 0:",
        "    level = \"Чисто\"",
        "elif ___ >= 100:",
        "    level = \"Тревога\"",
        "else:",
        "    level = \"___\""
      ],
      "reference": [
        "if count == 0:",
        "    level = \"Чисто\"",
        "elif total >= 100:",
        "    level = \"Тревога\"",
        "else:",
        "    level = \"Наблюдение\""
      ]
    },
    {
      "id": "report",
      "role": "Связист",
      "title": "Доклад лесной охране",
      "task": "Напечатай три строки сводки f-строками, как в ТЗ.",

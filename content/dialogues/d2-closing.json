      "id": "n11"
    },
    {
      "type": "say",
      "who": "gromov",
      "mood": "joy",
      "text": "Семь раз проверь — один раз запусти. Верно.",
      "id": "n12",
      "next": "n14"
    },
    {
      "type": "say",
      "who": "gromov",
      "mood": "neutral",
      "text": "Вижу. Тогда по традиции.",
